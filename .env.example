# Copy to .env and fill in. NEVER commit a filled-in .env.
# The HMAC secret comes from the ZkVerify dashboard: Rotate Secret (one-time
# plaintext). The server refuses to start without it.
AGENT_GAMES_HMAC_SECRET=
# Kurier API key (mainnet) from https://kurier.xyz — free signup.
# Leave blank to skip Kurier (the agent still answers with its local proof).
KURIER_API_KEY=
# Kurier mode: mock | live | off. Unset = live iff KURIER_API_KEY is set, else off.
KURIER_MODE=
# Server port (default 3000).
PORT=3000
